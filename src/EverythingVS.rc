#pragma code_page(65001)
#include "resource.h"
#include <winres.h>

IDI_APP_ICON ICON "app.ico"

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New Search Window\tCtrl+N",  IDM_FILE_NEW_WINDOW
        MENUITEM "&Export Results...\tCtrl+S",  IDM_FILE_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "&Open\tEnter",                IDM_FILE_OPEN
        MENUITEM "Open &Path\tCtrl+Enter",      IDM_FILE_OPEN_PATH
        MENUITEM "P&roperties\tAlt+Enter",      IDM_FILE_PROPERTIES
        MENUITEM "&Delete\tDel",                IDM_FILE_DELETE
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tCtrl+Q",               IDM_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy File(s)\tCtrl+C",                       IDM_EDIT_COPY_FILES
        MENUITEM "Copy Full &Path to Clipboard\tCtrl+Shift+C",  IDM_EDIT_COPY_FULL_PATH
        MENUITEM "Copy File &Name",                             IDM_EDIT_COPY_NAME
        MENUITEM "Copy F&older Path",                           IDM_EDIT_COPY_FOLDER_PATH
        MENUITEM SEPARATOR
        MENUITEM "Select &All\tCtrl+A",                         IDM_EDIT_SELECT_ALL
        MENUITEM "&Invert Selection",                           IDM_EDIT_INVERT_SELECTION
    END
    POPUP "&View"
    BEGIN
        POPUP "&Filters"
        BEGIN
            MENUITEM "&Everything",             IDM_VIEW_FILTER_ALL
            MENUITEM "&Audio",                  IDM_VIEW_FILTER_AUDIO
            MENUITEM "&Compressed",             IDM_VIEW_FILTER_COMPRESSED
            MENUITEM "&Document",               IDM_VIEW_FILTER_DOCUMENT
            MENUITEM "E&xecutable",             IDM_VIEW_FILTER_EXECUTABLE
            MENUITEM "&Folder",                 IDM_VIEW_FILTER_FOLDER
            MENUITEM "&Picture",                IDM_VIEW_FILTER_PICTURE
            MENUITEM "&Video",                  IDM_VIEW_FILTER_VIDEO
        END
        POPUP "&Language"
        BEGIN
            MENUITEM "&English",                IDM_VIEW_LANG_EN
            MENUITEM "&Arabic (العربية)",       IDM_VIEW_LANG_AR
        END
        MENUITEM SEPARATOR
        MENUITEM "&Dark Mode\tCtrl+D",          IDM_VIEW_DARK_MODE
        MENUITEM "Always On &Top",              IDM_VIEW_ALWAYS_ON_TOP
        MENUITEM "&Refresh\tF5",                IDM_VIEW_REFRESH
        MENUITEM "&Fullscreen\tF11",            IDM_VIEW_FULLSCREEN
    END
    POPUP "&Search"
    BEGIN
        MENUITEM "Match &Case\tCtrl+I",         IDM_SEARCH_MATCH_CASE
        MENUITEM "Match Whole &Word\tCtrl+B",   IDM_SEARCH_MATCH_WHOLE_WORD
        MENUITEM "Match &Path\tCtrl+U",         IDM_SEARCH_MATCH_PATH
        MENUITEM "Enable &Regex\tCtrl+R",       IDM_SEARCH_REGEX
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&HTTP Server (Localhost)",    IDM_TOOLS_HTTP_SERVER
        MENUITEM "Open HTTP Search in &Browser",IDM_TOOLS_OPEN_HTTP_URL
        MENUITEM "&Rebuild Index",              IDM_TOOLS_REBUILD_INDEX
        MENUITEM SEPARATOR
        MENUITEM "Run as &Administrator (Fast NTFS MFT)", IDM_TOOLS_RUN_AS_ADMIN
        MENUITEM "Open &Everything.ini",        IDM_TOOLS_OPEN_INI
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "Search &Syntax",              IDM_HELP_SYNTAX
        MENUITEM "&About EverythingVS",         IDM_HELP_ABOUT
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    "N", IDM_FILE_NEW_WINDOW,           VIRTKEY, CONTROL
    "S", IDM_FILE_EXPORT,               VIRTKEY, CONTROL
    "Q", IDM_FILE_EXIT,                 VIRTKEY, CONTROL
    "C", IDM_EDIT_COPY_FULL_PATH,       VIRTKEY, CONTROL, SHIFT
    "A", IDM_EDIT_SELECT_ALL,           VIRTKEY, CONTROL
    "D", IDM_VIEW_DARK_MODE,            VIRTKEY, CONTROL
    "I", IDM_SEARCH_MATCH_CASE,         VIRTKEY, CONTROL
    "B", IDM_SEARCH_MATCH_WHOLE_WORD,   VIRTKEY, CONTROL
    "U", IDM_SEARCH_MATCH_PATH,         VIRTKEY, CONTROL
    "R", IDM_SEARCH_REGEX,              VIRTKEY, CONTROL
    VK_F5,  IDM_VIEW_REFRESH,           VIRTKEY
    VK_F11, IDM_VIEW_FULLSCREEN,        VIRTKEY
    VK_RETURN, IDM_FILE_PROPERTIES,     VIRTKEY, ALT
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 3,1,0,0
 PRODUCTVERSION 3,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EverythingVS"
            VALUE "FileDescription", "EverythingVS — Native Win32 C++20 Instant File Search"
            VALUE "FileVersion", "3.1.0.0"
            VALUE "InternalName", "EverythingVS"
            VALUE "OriginalFilename", "EverythingVS.exe"
            VALUE "ProductName", "EverythingVS"
            VALUE "ProductVersion", "3.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
